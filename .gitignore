# Unreal Engine project .gitignore

# Build artifacts
Binaries/
/Build/

# Cache and temporary files
DerivedDataCache/
Intermediate/
Saved/
Content/__ExternalActors_/


# Baked lighting data (regenerate with Build > Build Lighting)
*_BuiltData.uasset

# Logs and temp files
*.log
*.tmp

# User-specific files
*.user
*.suo
*.userprefs
*.o

# Visual Studio
.vs/
*.sln
*.VC.db
*.opendb

# Backup files
*.bak
*.swp

# Visual Studio Code
.vscode/

# JetBrains IDE
.idea/

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
